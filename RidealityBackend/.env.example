# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://rideality:rideality_secret@localhost:5432/rideality?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_LENGTH=6
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_DEV_BYPASS_CODE=123456

# Rate limiting
OTP_RATE_LIMIT_WINDOW_MS=60000
OTP_RATE_LIMIT_MAX=5

# Default region (seeded)
DEFAULT_REGION_CODE=PK

# File uploads (optional — local stub if not set)
UPLOAD_PROVIDER=local
UPLOAD_LOCAL_PATH=./uploads
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Logging (daily files in LOG_PATH)
LOG_PATH=./logs
LOG_LEVEL=info
LOG_MAX_FILES=14d
LOG_ZIP_ARCHIVE=true

# Admin seed (used by prisma/seed.ts)
ADMIN_EMAIL=admin@rideality.com
ADMIN_PASSWORD=Admin@123456

# Firebase Admin (FCM) — path to service account JSON on server
# FIREBASE_SERVICE_ACCOUNT_PATH=/opt/rideality/secrets/rideality-firebase-adminsdk.json
# GOOGLE_APPLICATION_CREDENTIALS=/opt/rideality/secrets/rideality-firebase-adminsdk.json
# FIREBASE_PROJECT_ID=rideality

# Google Places / Geocoding — server-side only (never put this key in Flutter)
# Enable: Places API, Places API (New optional), Geocoding API
# Restrict the key by IP / server, not by Android/iOS package.
GOOGLE_PLACES_API_KEY=AIzaSyBrqFXpS37FvujkuBpkddSn0LpGwxroqok
# GOOGLE_PLACES_COUNTRY=pk
# GOOGLE_PLACES_LANGUAGE=en
