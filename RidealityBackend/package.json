{
  "name": "rideality-backend",
  "version": "1.0.0",
  "description": "Rideality user management API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "ms:run": "tsx src/microservices/server.ts",
    "ms:start": "bash scripts/start-microservices.sh",
    "ms:gateway": "SERVICE_NAME=gateway PORT=3000 tsx src/microservices/server.ts",
    "ms:auth": "SERVICE_NAME=auth PORT=3001 tsx src/microservices/server.ts",
    "ms:users": "SERVICE_NAME=users PORT=3002 tsx src/microservices/server.ts",
    "ms:fleet": "SERVICE_NAME=fleet PORT=3003 tsx src/microservices/server.ts",
    "ms:finance": "SERVICE_NAME=finance PORT=3004 tsx src/microservices/server.ts",
    "ms:admin": "SERVICE_NAME=admin PORT=3005 tsx src/microservices/server.ts",
    "ws:dev": "npm --prefix ws-gateway run dev",
    "ws:start": "npm --prefix ws-gateway run start",
    "test:dispatch": "tsx scripts/load-test-dispatch.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-demo": "tsx prisma/reset-demo.ts --yes",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio",
    "postman:generate": "node postman/generate-postman-collection.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.56"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.29",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
